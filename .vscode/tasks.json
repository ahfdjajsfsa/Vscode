{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create C/output folder",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if not exist \"D:\\Github\\Vscode\\C\\output\" mkdir \"D:\\Github\\Vscode\\C\\output\""
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "build active file to C/output (g++)",
            "command": "D:\\code_interpreter\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "D:\\Github\\Vscode\\C\\output\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\code_interpreter\\mingw64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Create C/output folder"
            ],
            "detail": "Compile active C/C++ file to D:\\Github\\Vscode\\C\\output."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "D:\\code_interpreter\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "D:\\Github\\Vscode\\C\\output\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "D:\\code_interpreter\\mingw64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Create C/output folder"
            ],
            "detail": "Task generated by Debugger."
        }
    ]
